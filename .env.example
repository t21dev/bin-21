# Database (SQLite)
# Path to the SQLite file. On Railway point this at the mounted volume.
# Local default if unset: ./.data/bin21.db
DATABASE_PATH=/data/bin21.db

# Cloudflare R2 (S3-compatible object storage) — holds paste content
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=bin21-pastes
R2_PUBLIC_URL=https://your-r2-public-url.com

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security
IP_HASH_SALT=generate-with-openssl-rand-hex-32

# Bot Protection
BOT_PROTECTION_ENABLED=true

# Expired-paste janitor. Deletes expired rows AND their R2 objects, so leave it
# unset locally — a dev machine pointed at the production bucket would reclaim
# live storage. Set to true only on the deployed instance.
JANITOR_ENABLED=false

# Admin analytics at /admin. Unset (the default) and the route returns 404;
# it does not exist. Set to a long random secret to enable.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
